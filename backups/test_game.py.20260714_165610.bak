# 测试游戏文件
def calculate_damage(attacker_power, defender_defense):
    damage = attacker_power - defender_defense
    hp = 100
    hp -= damage
    return hp


def heal_player(current_hp, heal_amount):
    current_hp += heal_amount
    return current_hp


if __name__ == '__main__':
    result = calculate_damage(50, 20)
    print(f'剩余血量: {result}')
